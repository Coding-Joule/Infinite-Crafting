# Copy to .env.local and fill in. Never commit a real key.
# Without LLM_API_KEY the game uses its built-in fallback combination engine.

# Which provider adapter to use: "anthropic" (default) or "openai-compatible"
LLM_PROVIDER=anthropic

# Secret key for the provider. Only read server-side.
LLM_API_KEY=

# Optional model override. Defaults: anthropic -> claude-opus-5-5
LLM_MODEL=

# Only for openai-compatible providers (e.g. https://api.openai.com/v1)
LLM_BASE_URL=
